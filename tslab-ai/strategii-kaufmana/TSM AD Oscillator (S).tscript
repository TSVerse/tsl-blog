        <Block Key="exitRule" Category="Const" Location="1000 416" TypeName="ConverterItem">
          <EditItem Guid="E508B0E9-413D-4AA0-9594-7ACF8B81CDBD" CodeName="exitRule" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.Script.Handlers.ConstGen, TSLab.Script.Handlers">
            <Parameters>
              <Parameter Name="Value" TypeName="Double" Value="2" />
            </Parameters>
          </EditItem>
        </Block>
        <Block Key="positionSize" Category="Formula" Location="0 544" TypeName="DoubleCustomHandlerItem" Width="120" Height="60" ResizablePartWidth="142" ResizablePartHeight="80" OpenParams="true">
          <EditItem Guid="81DB0147-B7E8-4E39-93D9-3CBC09BEDAE3" CodeName="positionSize" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.ScriptEngine.Template.DoubleCustomHandlerItem+Handler, TSLab.ScriptEngine, Version=3.0.3.1244, Culture=neutral, PublicKeyToken=null">
            <Parameters>
              <Parameter Name="Expression" TypeName="String" Value="Math.Max(1, investment / Math.Max(atr20 * bigPointValue, 0.00000001))" />
              <Parameter Name="StartIndex" TypeName="Int32" Value="20" />
            </Parameters>
          </EditItem>
        </Block>
        <Block Key="longSignal" Category="Formula" Location="250 544" TypeName="BoolCustomHandlerItem" Width="120" Height="60" ResizablePartWidth="190" ResizablePartHeight="80" OpenParams="true">
          <EditItem Guid="D1E925D7-F496-4970-B980-61849F7D1217" CodeName="longSignal" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.ScriptEngine.Template.BoolCustomHandlerItem+Handler, TSLab.ScriptEngine, Version=3.0.3.1244, Culture=neutral, PublicKeyToken=null">
            <Parameters>
              <Parameter Name="Expression" TypeName="String" Value="entryRule &lt; 1.5 ? adOsc &lt; buyBand : adOscSmooth &lt; buyBand" />
              <Parameter Name="StartIndex" TypeName="Int32" Value="1" />
            </Parameters>
          </EditItem>
        </Block>
        <Block Key="shortSignal" Category="Formula" Location="500 544" TypeName="BoolCustomHandlerItem" Width="120" Height="60" ResizablePartWidth="190" ResizablePartHeight="80" OpenParams="true">
          <EditItem Guid="23DC43C9-DD95-4BEB-A24B-14AD5A0986E4" CodeName="shortSignal" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.ScriptEngine.Template.BoolCustomHandlerItem+Handler, TSLab.ScriptEngine, Version=3.0.3.1244, Culture=neutral, PublicKeyToken=null">
            <Parameters>
              <Parameter Name="Expression" TypeName="String" Value="entryRule &lt; 1.5 ? adOsc &gt; sellBand : adOscSmooth &gt; sellBand" />
              <Parameter Name="StartIndex" TypeName="Int32" Value="1" />
            </Parameters>
          </EditItem>
        </Block>
        <Block Key="longExitSignal" Category="Formula" Location="750 544" TypeName="BoolCustomHandlerItem" Width="120" Height="60" ResizablePartWidth="190" ResizablePartHeight="80" OpenParams="true">
          <EditItem Guid="888C52D3-6A5A-45B9-BD62-6C4FE02AEED0" CodeName="longExitSignal" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.ScriptEngine.Template.BoolCustomHandlerItem+Handler, TSLab.ScriptEngine, Version=3.0.3.1244, Culture=neutral, PublicKeyToken=null">
            <Parameters>
              <Parameter Name="Expression" TypeName="String" Value="exitRule &lt; 1.5 ? true : adOsc &gt; zeroMid" />
              <Parameter Name="StartIndex" TypeName="Int32" Value="1" />
            </Parameters>
          </EditItem>
        </Block>
        <Block Key="shortExitSignal" Category="Formula" Location="1000 544" TypeName="BoolCustomHandlerItem" Width="120" Height="60" ResizablePartWidth="190" ResizablePartHeight="80" OpenParams="true">
          <EditItem Guid="0900664C-32B7-441F-9302-E8F146D05E51" CodeName="shortExitSignal" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.ScriptEngine.Template.BoolCustomHandlerItem+Handler, TSLab.ScriptEngine, Version=3.0.3.1244, Culture=neutral, PublicKeyToken=null">
            <Parameters>
              <Parameter Name="Expression" TypeName="String" Value="exitRule &lt; 1.5 ? true : adOsc &lt; zeroMid" />
              <Parameter Name="StartIndex" TypeName="Int32" Value="1" />
            </Parameters>
