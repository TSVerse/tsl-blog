          <EditItem Guid="C4E7246A-6D34-4D7F-A195-01C4F0ECD870" CodeName="investment" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.Script.Handlers.ConstGen, TSLab.Script.Handlers">
            <Parameters>
              <Parameter Name="Value" TypeName="Double" Value="1000" />
            </Parameters>
