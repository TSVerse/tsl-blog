        </Block>
        <Block Key="longProtectPrice" Category="Formula" Location="0 672" TypeName="DoubleCustomHandlerItem" Width="120" Height="60" ResizablePartWidth="142" ResizablePartHeight="80" OpenParams="true">
          <EditItem Guid="7D5DAF0C-8896-4AF4-A167-544A83DD1903" CodeName="longProtectPrice" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.ScriptEngine.Template.DoubleCustomHandlerItem+Handler, TSLab.ScriptEngine, Version=3.0.3.1244, Culture=neutral, PublicKeyToken=null">
            <Parameters>
              <Parameter Name="Expression" TypeName="String" Value="close - atr20 * 2" />
