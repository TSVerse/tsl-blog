          <EditItem Guid="DEEFB21D-5B16-4010-9772-C0F276238532" CodeName="entryRule" IsParametersVisible="true" OnlyValueHandlersCanUsed="false" HandlerTypeName="TSLab.Script.Handlers.ConstGen, TSLab.Script.Handlers">
            <Parameters>
              <Parameter Name="Value" TypeName="Double" Value="1" />
            </Parameters>
